---
layout: layouts/base.njk
templateClass: tmpl-report
---

<article class="o-article">
  <div class="u-wrapper">
    <header class="o-article__header">
      <div class="u-grid-from--desktop">
        <div class="c-tagline">{{ [contract, location].join(', ') }}</div>
        <div class="c-tagline">{{ timeframe }}</div>
      </div>
      {% if heroOutput %}
      <div class="case-hero-grid">
        <div class="case-hero-copy"><h1 class="o-article__title">{{ title }}</h1><p class="case-hero-thesis">{{ heroThesis or intro }}</p><p class="case-hero-role">{{ heroRole }}</p></div>
        <figure class="case-hero-output" id="tldr"><div class="email-output-crop"><img src="{{ heroOutput }}" width="680" height="800" alt="{{ heroOutputAlt }}"></div><figcaption>Actual generated output · Synthetic sample data</figcaption></figure>
      </div>
      {% else %}<h1 class="o-article__title u-thick u-grow--thick">{{ title }}</h1>{% endif %}
    </header>

    {% if not heroOutput %}<a class="text-link case-proof-link" href="#tldr">Show me the work ↓</a>{% endif %}

  </div>

  {% if short == "wise" or short == "caballeros" %}<nav class="case-chapters u-wrapper" aria-label="Case study chapters"><a href="#tldr">The work</a><a href="#what-changed">What changed</a><a href="#decisions">The thinking</a></nav>{% endif %}

  <div class="u-text">
    <div class="u-wrapper">
      <div class="o-article__content">
        {{ content | safe }}
      </div>
    </div>
  </div>

  <div class="u-wrapper"><details class="project-credits"><summary>Role, tools & collaborators</summary>
    <div class="project-credits-grid">{% for key, list in properties %}<div><h3>{{ key | capitalize }}</h3><ul>{% for item in list %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endfor %}</div>
  </details></div>
  <div class="u-wrapper u-center">
    <a class="c-btn c-btn--primary" href="{{ '/' | url }}">
      <span class="c-btn__icon">←</span>
      <span class="c-btn__text">Back to work
      </span>
    </a>
  </div>
</article>