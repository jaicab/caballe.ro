<div class="u-wrapper private-session-area">
  <p class="private-session-notice" data-private-session-notice role="status" hidden></p>
  <details class="private-session-controls" data-private-session-controls hidden>
    <summary>Private access <span aria-hidden="true">✓</span></summary>
    <nav class="private-session-projects" data-private-projects aria-label="Private case studies"></nav>
    <p data-private-expiry></p>
    <p>Your invitation unlocks this tab. Keep browsing the portfolio as normal.</p>
    <div class="private-session-actions"><button type="button" data-private-replay>About this access</button><button type="button" data-private-lock>Lock private work</button></div>
  </details>
</div>
<dialog class="private-welcome" data-private-welcome aria-labelledby="private-welcome-title" aria-describedby="private-welcome-description">
  <p class="eyebrow">A closer look</p>
  <h2 id="private-welcome-title">Access granted.</h2>
  <p id="private-welcome-description">You can now explore the private projects alongside the rest of my work. No extra steps between case studies.</p>
  <p class="private-welcome-note">Access stays in this tab until the session expires. You can lock it at any time using Private access.</p>
  <button type="button" class="c-btn c-btn--primary" data-private-continue>Continue exploring <span aria-hidden="true">→</span></button>
</dialog>
